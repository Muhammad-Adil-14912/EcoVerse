rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /volunteers/{volunteerId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'interest', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'interest', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.interest is string
        && request.resource.data.interest.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if request.resource.data.keys().hasOnly([
          'eventId', 'eventTitle', 'name', 'email', 'phone',
          'participants', 'note', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'eventId', 'eventTitle', 'name', 'email', 'phone',
          'participants', 'note', 'createdAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && request.resource.data.eventTitle == get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.title
        && request.resource.data.eventTitle is string
        && request.resource.data.eventTitle.size() <= 160
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.participants is int
        && request.resource.data.participants >= 1
        && request.resource.data.participants <= 20
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // All collections not explicitly listed above are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
